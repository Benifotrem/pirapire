NODE_ENV=production
LOG_LEVEL=info

# Baileys / WhatsApp
WHATSAPP_AUTH_DIR=./auth_sessions
WHATSAPP_COMMAND_PREFIX=!

# Redis / BullMQ
REDIS_URL=redis://redis:6379

# Pirapire API (Laravel backend)
PIRAPIRE_API_BASE_URL=http://nginx:8080/api
PIRAPIRE_API_TOKEN=changeme-generate-a-long-random-token

# RoboSats (optional — the poller stays off if unset; see README "Alertas
# P2P de RoboSats". No default: RoboSats is federated/Tor-first, there is
# no single stable clearnet API to point at. Set this to a coordinator
# you trust, e.g. reached through a local Tor SOCKS proxy.)
ROBOSATS_API_BASE_URL=
ROBOSATS_POLL_INTERVAL_SECONDS=60

# Alert tiers
FREE_TIER_DELAY_MINUTES=10

# Mempool
MEMPOOL_API_BASE_URL=https://mempool.space/api

# Escrow
ESCROW_FEE_PERCENT=1.5

# Telegram healthcheck / QR recovery bot (optional — notifications are
# skipped with a log warning if either is unset). Create a bot via
# @BotFather and get your chat id from @userinfobot.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Internal-only API (never published to the host) that lets Laravel ask
# this bot to send a WhatsApp message — used for admin login codes. Must
# match WHATSAPP_BOT_INTERNAL_TOKEN in web/.env. Generate with:
# openssl rand -hex 32
WHATSAPP_BOT_INTERNAL_PORT=3001
WHATSAPP_BOT_INTERNAL_TOKEN=changeme-generate-a-long-random-token
