APP_NAME=Pirapire
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Asuncion
APP_URL=https://pirapire.pro

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pirapire
DB_USERNAME=pirapire
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=pirapire

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Pirapire ---------------------------------------------------------

# LNbits instance backing the Lightning job escrow (core payments API —
# LNbits has no hold-invoice extension; see app/Services/Escrow/EscrowService.php).
LNBITS_BASE_URL=http://lnbits:5000
LNBITS_ADMIN_KEY=
LNBITS_INVOICE_READ_KEY=
LNBITS_WEBHOOK_SECRET=

ESCROW_FEE_PERCENT=1.5

# Private admin ops bot (App\Services\Telegram\TelegramBotClient) — admin
# panel login codes and the "/vincular CODE" account-linking handshake.
# Generate a bot via @BotFather. TELEGRAM_WEBHOOK_SECRET is your own
# secret (openssl rand -hex 32) checked against Telegram's own
# X-Telegram-Bot-Api-Secret-Token header — see README "Panel de
# administración" for the one-time setWebhook call.
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Public customer-facing bot — /mempool, /vip, /escrow, RoboSats alerts
# (App\Http\Controllers\TelegramCustomerWebhookController). Deliberately a
# *different* bot/token from the admin one above, created via @BotFather —
# see README "Panel de administración" for why they're kept separate.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_WEBHOOK_SECRET=

MEMPOOL_API_BASE_URL=https://mempool.space/api

# RoboSats P2P order alerts. No default — RoboSats is a federated, Tor-first
# exchange with no single stable clearnet API. Left unset, the scheduled
# `robosats:poll` command no-ops with a logged warning; /mempool, /vip and
# /escrow are unaffected. See README "Alertas P2P de RoboSats".
ROBOSATS_API_BASE_URL=

# Optional SOCKS5/Tor proxy for ROBOSATS_API_BASE_URL, needed when it's a
# .onion address. With docker-compose (which ships a "tor" service), use
# socks5h://tor:9050. Leave unset to connect directly, with no proxy — a
# Tor outage here never breaks the scheduler or /mempool, /vip, /escrow;
# it just makes robosats:poll fetch an empty book until Tor recovers. See
# README "Configuración de RoboSats (Tor / proxy)".
ROBOSATS_PROXY_URL=

FREE_TIER_DELAY_MINUTES=10
