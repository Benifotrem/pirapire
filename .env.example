# Read by `docker compose` itself for the ${VAR} substitutions in
# docker-compose.yml (Postgres container bootstrap, LNbits funding
# backend) — this is separate from web/.env, which is injected into the
# app containers via `env_file:` instead. Compose only auto-loads a .env
# from the same directory as docker-compose.yml, so this file has to live
# at the project root, not under web/.
#
# DB_DATABASE/DB_USERNAME/DB_PASSWORD here set up the Postgres container
# on first boot — they must match the DB_DATABASE/DB_USERNAME/DB_PASSWORD
# in web/.env, since that's what Laravel uses to connect to this same
# database.
DB_DATABASE=pirapire
DB_USERNAME=pirapire
DB_PASSWORD=

# FakeWallet (default) moves no real sats — see the `lnbits` service
# comment in docker-compose.yml before going to production.
LNBITS_BACKEND_WALLET_CLASS=FakeWallet
