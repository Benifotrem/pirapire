# Read by `docker compose` itself for the ${VAR} substitutions in
# docker-compose.yml (Postgres container bootstrap, LNbits funding
# backend) — this is separate from web/.env, which is injected into the
# app containers via `env_file:` instead. Compose only auto-loads a .env
# from the same directory as docker-compose.yml, so this file has to live
# at the project root, not under web/.
#
# DB_DATABASE/DB_USERNAME/DB_PASSWORD here set up the Postgres container
# on first boot — they must match the DB_DATABASE/DB_USERNAME/DB_PASSWORD
# in web/.env, since that's what Laravel uses to connect to this same
# database.
DB_DATABASE=pirapire
DB_USERNAME=pirapire
DB_PASSWORD=

# FakeWallet (default) moves no real sats — see the `lnbits` service
# comment in docker-compose.yml before going to production.
LNBITS_BACKEND_WALLET_CLASS=FakeWallet

# To go to production without running your own Lightning node/channels,
# set LNBITS_BACKEND_WALLET_CLASS=BlinkWallet above and fill these in
# (get BLINK_TOKEN from https://dashboard.blink.sv — no KYC required as
# of this writing). Blink then custodies the actual sats/liquidity;
# LNbits just talks to their API. Leave BLINK_TOKEN empty while
# LNBITS_BACKEND_WALLET_CLASS is FakeWallet, it's simply unused.
# BLINK_API_ENDPOINT=https://api.blink.sv/graphql
# BLINK_WS_ENDPOINT=wss://ws.blink.sv/graphql
# BLINK_TOKEN=

# Token for the `cloudflared` service — routes pirapire.pro to this VPS
# through a Cloudflare Tunnel with no public port open on the host at
# all. Get it by creating a tunnel in the Cloudflare Zero Trust dashboard
# (Networks → Tunnels → Create a tunnel → Cloudflared) and copying the
# token shown on the "install connector" step — not a certificate, not an
# API key, a single opaque string. See README "Cloudflare Tunnel".
CLOUDFLARE_TUNNEL_TOKEN=

# Only on the VPS: makes every `docker compose` command also include the
# "production"-profiled cloudflared service (see docker-compose.yml) with
# no extra flags to remember. Leave this commented out for local dev —
# there's no tunnel token locally, and docker-compose.local.yml already
# publishes nginx/lnbits on localhost instead.
# COMPOSE_PROFILES=production
